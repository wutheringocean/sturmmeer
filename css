:root { color-scheme: light; --ink:#252525; --muted:#858580; --line:#e9e9e5; }
* { box-sizing:border-box; }
body { margin:0; background:#fff; color:var(--ink); font-family: "Pretendard", "Noto Sans KR", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing:antialiased; }
button { font:inherit; color:inherit; cursor:pointer; }
button:focus-visible, a:focus-visible { outline:2px solid #65655f; outline-offset:5px; }
.page { min-height:100svh; max-width:1440px; margin:auto; padding:38px 6vw 26px; display:flex; flex-direction:column; }
header { display:flex; justify-content:space-between; align-items:center; gap:20px; font-size:11px; letter-spacing:.14em; }
.brand { display:flex; gap:10px; align-items:center; font-weight:600; }
.dot { width:6px; height:6px; border-radius:50%; background:#383833; }
.header-note { color:var(--muted); letter-spacing:.03em; }
main { width:100%; max-width:1000px; margin:auto; padding:100px 0; display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:90px; }
.eyebrow { margin:0 0 26px; color:var(--muted); font-size:10px; letter-spacing:.2em; }
h1 { font-weight:400; font-size:clamp(38px,4.2vw,58px); letter-spacing:-.065em; line-height:1.35; margin:0 0 24px; }
.intro { font-size:14px; color:#858580; line-height:1.95; margin:0 0 46px; word-break:keep-all; }
nav { max-width:330px; }
.entry { width:100%; border:0; border-bottom:1px solid var(--line); background:white; padding:20px 0; text-align:left; display:flex; align-items:center; gap:20px; transition:padding .2s, color .2s; }
.entry:first-child { border-top:1px solid var(--line); }
.entry:hover, .entry[aria-expanded="true"] { padding-left:9px; padding-right:9px; }
.entry[aria-expanded="true"] .label { font-weight:600; }
.number { color:#aaa9a3; font-size:10px; letter-spacing:.06em; }
.label { font-size:14px; }
.arrow { margin-left:auto; color:#8f8f87; font-size:18px; font-weight:300; }
.stage { min-height:380px; display:grid; place-items:center; position:relative; }
.empty { text-align:center; color:#aaa9a3; }
.empty-icon { width:54px; height:42px; border:1px solid #deded8; border-radius:5px; margin:0 auto 20px; position:relative; }
.empty-icon::before { content:""; position:absolute; top:10px; left:0; width:100%; border-top:1px solid #e8e8e3; }
.empty-icon::after { content:""; position:absolute; top:4px; left:5px; width:3px; height:3px; border-radius:50%; background:#d6d6cf; }
.empty p { font-size:12px; line-height:1.8; }
/* 화면의 다른 내용 위에 고정되는 중앙 팝업 */
dialog { position:fixed; inset:auto; top:50%; left:50%; transform:translate(-50%, -50%); z-index:1000; width:calc(100vw - 40px); max-width:440px; max-height:calc(100svh - 40px); padding:0; margin:0; border:1px solid #e3e3de; border-radius:12px; background:#fff; color:var(--ink); box-shadow:0 18px 65px -24px #24241a30,0 2px 8px #24241a05; overflow:hidden; }
dialog[open] { display:flex; flex-direction:column; animation:arrive .22s ease-out; }
.window-bar { flex-shrink:0; }
.window-bar { display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #efefeb; padding:12px 16px 12px 22px; }
.window-caption { font-size:11px; color:#93938b; letter-spacing:.04em; }
.close { display:grid; place-items:center; border:0; background:transparent; width:32px; height:32px; border-radius:6px; font-size:22px; line-height:1; color:#8c8c84; }
.close:hover { background:#f5f5f2; color:#252525; }
.window-body { padding:34px 32px 38px; min-height:0; max-height:calc(100svh - 110px); overflow:auto; overscroll-behavior:contain; }
.category { font-size:10px; color:#a0a098; letter-spacing:.16em; margin:0 0 18px; }
h2 { margin:0 0 22px; font-size:25px; font-weight:500; letter-spacing:-.045em; }
.copy { font-size:14px; line-height:2; color:#74746c; word-break:keep-all; overflow-wrap:anywhere; white-space:pre-wrap; margin:0; }
.sample { margin:30px 0 0; padding-top:16px; border-top:1px solid #efefeb; color:#a5a59d; font-size:10px; }
footer { display:flex; justify-content:space-between; gap:20px; color:#aaa9a3; font-size:10px; letter-spacing:.025em; line-height:1.8; }
@keyframes arrive { from { opacity:0; transform:translate(-50%, calc(-50% + 8px)); } to { opacity:1; transform:translate(-50%, -50%); } }
@media (max-width:760px) { .page { padding:27px 26px 24px; } .header-note { display:none; } main { padding:68px 0 55px; grid-template-columns:1fr; gap:34px; max-width:440px; } h1 { font-size:42px; } .intro { margin-bottom:28px; } nav { max-width:none; } .stage { min-height:130px; } .empty-icon { display:none; } .empty p { font-size:11px; } .window-body { padding:28px 25px 30px; max-height:calc(100svh - 110px); } footer { font-size:9px; } }
@media (prefers-reduced-motion:reduce) { *, *::before, *::after { animation:none !important; transition:none !important; } }
